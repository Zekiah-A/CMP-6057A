# Copy to .env and replace the placeholder with this reference role's password.
# This app rejects other hosts, database names, roles, and URL query parameters.
DATABASE_URL="postgresql://newsletter_reference_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/newsletter_reference"

# Needed when Auth.js is added in slice 2; generate your own random value.
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"
