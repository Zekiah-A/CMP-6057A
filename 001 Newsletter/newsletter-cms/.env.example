# Database configuration
# Set DATABASE_URL to the connection URL for newsletter_app, with the password, host (127.0.0.1), port
# 5432, and database newsletter_db.
# For example: postgresql://USER:PASSWORD@127.0.0.1:5432/newsletter_db. Where USER and PASSWORD are
# replaced with the corresponding details for the postgresql database. - Zekiah

DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Auth configuration
# Make this a secure random password, it can be generated with `openssl rand -base64 32`
AUTH_SECRET="my+random+base64+value+here="